# --- image ---
VLLM_IMAGE=vllm/vllm-openai:v0.27.1

# --- container user / caches ---
# The container runs as this user so downloaded weights and caches in CACHE_DIR are owned by you.
# Set to the output of `id -u` / `id -g`.
RUN_UID=1000
RUN_GID=1000
# HF weights, vLLM/torch.compile/triton/flashinfer caches (≈ 25 GB after `make models`)
CACHE_DIR=./cache
# Only needed for gated repos (the Nemotron repos are not gated at the time of writing)
HF_TOKEN=

# --- network / security ---
# 127.0.0.1 = only this host (clients on the Spark itself); 0.0.0.0 = all interfaces
BIND=127.0.0.1
PORT=8000
# Bearer token for the API; empty = no authentication. Generate with: openssl rand -hex 32
API_KEY=

# --- model ---
MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
SERVED_MODEL_NAME=nemotron-3.5-lightning
# Native maximum is 1M tokens; smaller = less KV-cache reservation, more parallel sequences
MAX_MODEL_LEN=131072
# Share of the unified 128 GB memory vLLM reserves at startup (weights + activations + KV cache)
GPU_MEMORY_UTILIZATION=0.75
# Max concurrently running sequences
MAX_NUM_SEQS=16
# fp8 | auto (= model dtype)
KV_CACHE_DTYPE=fp8

# --- speculative decoding ---
# dspark (NVIDIA's recipe for DGX Spark) | dflash | mtp (built-in heads) | none
SPEC_METHOD=dspark
SPEC_TOKENS=3
DSPARK_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark
DFLASH_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DFlash

# Extra `vllm serve` arguments, appended verbatim (space-separated)
EXTRA_ARGS=
